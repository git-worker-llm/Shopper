<Window x:Class="JewelleryManagementApp.WPF.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AuraJewels ERP - Login" 
        Height="445" 
        Width="350"
        Background="{DynamicResource DarkBgBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderThickness="1"
        BorderBrush="{DynamicResource BorderGoldBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Top Bar -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderDarkBrush}">
            <Grid>
                <TextBlock Text="AURANET billing suite" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GoldPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Content="✕" Click="CloseButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" Padding="5,2" Margin="0" FontSize="12" Width="24" Height="24"
                        ToolTip="Terminate and close the AuraJewels ERP system.">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Main Panel -->
        <Border Grid.Row="1" Margin="25" Padding="25" Background="{DynamicResource CardInnerBgBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
            <StackPanel VerticalAlignment="Center">
                
                <!-- Stylised Gold Logo (Crown vector path) -->
                <Path Data="M 10,35 L 20,10 L 35,22 L 50,10 L 65,22 L 80,10 L 90,35 Z M 50,2 A 2,2 0 1 0 50,0 Z" 
                      Fill="{DynamicResource GoldPrimaryBrush}" 
                      Height="35" 
                      Width="60" 
                      Stretch="Fill" 
                      HorizontalAlignment="Center" 
                      Margin="0,0,0,10"/>
                
                <TextBlock Text="A U R A J E W E L S" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource GoldPrimaryBrush}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,2"/>
                           
                <TextBlock Text="PREMIER MANAGEMENT SYSTEM" 
                           FontSize="9" 
                           FontWeight="Medium" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <TextBlock Text="Username:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Text="admin" Height="38" Padding="10,6" Margin="0,0,0,12"/>

                <TextBlock Text="Password:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Password="admin" Height="38" Padding="10,6" Margin="0,0,0,15"/>

                <!-- Theme Selection sliding toggle switch -->
                <CheckBox x:Name="ThemeModeCheckbox" 
                          Content="Champagne Light Theme" 
                          Style="{StaticResource PremiumToggleSwitch}"
                          Checked="ThemeToggle_Checked" 
                          Unchecked="ThemeToggle_Unchecked" 
                          HorizontalAlignment="Left" 
                          Margin="0,0,0,20" 
                          ToolTip="Switch showroom visual theme dynamically between charcoal dark and champagne light modes."/>

                <Button Content="SECURE LOGIN" Click="LoginButton_Click" Height="40" Background="{DynamicResource GoldPrimaryBrush}" Foreground="#121212" FontWeight="Bold" FontSize="13" Margin="0"
                        ToolTip="Authenticate and launch the AuraJewels ERP suite."/>
                
                <!-- Demo login message -->
                <TextBlock Text="Use admin / admin for authorization" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
