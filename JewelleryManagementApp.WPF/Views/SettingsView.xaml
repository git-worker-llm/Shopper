<UserControl x:Class="JewelleryManagementApp.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource DarkBgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderGoldBrush}" Padding="0,0,0,15" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="SYSTEM ARCHITECTURE &amp; ENVIRONMENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}"/>
                <TextBlock Text="Global Enterprise Configuration Settings" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Configuration Panel Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Settings Form -->
            <Border Grid.Column="0" Margin="0,0,20,0" Padding="25" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}" VerticalAlignment="Top">
                <StackPanel>
                    
                    <!-- Dynamic Theme Toggle -->
                    <Border Margin="0,0,0,20" Background="{DynamicResource CardInnerBgBrush}" Padding="15,10" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Showroom Light Theme Mode" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}"/>
                                <TextBlock Text="Switches active environment to light marble layout" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="ThemeModeCheckbox" 
                                      IsChecked="{Binding Settings.IsLightTheme, Mode=TwoWay}" 
                                      Style="{StaticResource PremiumToggleSwitch}"
                                      Checked="ThemeMode_Changed" 
                                      Unchecked="ThemeMode_Changed" 
                                      HorizontalAlignment="Right" 
                                      VerticalAlignment="Center"
                                      ToolTip="Toggle dynamic dynamic layout styles live."/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Enterprise Brand Identity" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}" Margin="0,0,0,15"/>

                    <!-- Shop Name -->
                    <TextBlock Text="Luxury Shop / Showroom Name:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Settings.ShopName, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,6" Margin="0,0,0,12"/>

                    <!-- GSTIN -->
                    <TextBlock Text="GSTIN Registration Number:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Settings.GSTNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,6" Margin="0,0,0,12"/>

                    <!-- GSTRate Slider -->
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Reconciled GST Rate (%):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Settings.GSTRate, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}" Margin="0,0,0,4"/>
                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="30" Value="{Binding Settings.GSTRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" TickFrequency="0.25" IsSnapToTickEnabled="True"/>
                    </Grid>

                    <!-- Address -->
                    <TextBlock Text="Physical Showroom Address:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Settings.Address, UpdateSourceTrigger=PropertyChanged}" Height="75" Padding="10,6" Margin="0,0,0,15" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <!-- Logo Path -->
                    <TextBlock Text="Showroom Logo Directory Path:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Settings.LogoPath, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,6" Margin="0,0,0,25"/>

                    <Button Content="COMMIT CONFIGURATION" 
                            Command="{Binding SaveSettingsCommand}" 
                            Height="42" 
                            Background="{DynamicResource SuccessBrush}" 
                            Foreground="White" 
                            FontWeight="Bold" 
                            FontSize="13" 
                            Margin="0"
                            ToolTip="Commit brand details, address, and average GST rates back to system settings table."/>
                </StackPanel>
            </Border>

            <!-- Right: Instructions and Visual Reference -->
            <Border Grid.Column="1" Padding="25" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                <StackPanel>
                    <TextBlock Text="Configuration Manual" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}" Margin="0,0,0,15"/>

                    <TextBlock Text="GST Rate Tuning:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Standard GST on luxury Gold and Silver ornaments in India is set at 3.0%. For making charges, tax structures might involve higher slabs (such as 5%). The slider lets you reconcile the average tax rate instantly across the Billing Dispatch." 
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20" LineHeight="18"/>

                    <TextBlock Text="Digital Signatures &amp; DSC:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="The compliance center authenticates e-filings using standard DSC tokens. Ensure your USB token is connected and active when executing direct filing from the compliance hub." 
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20" LineHeight="18"/>

                    <TextBlock Text="System Version Details:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="4" Padding="15" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Core Engine Version: AuraNet Enterprise v4.12.0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Compliance Specifications: GSTIN schema v3.14" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Active Database: SQLite 3.32 - jewellery.db" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0"/>
                            </StackPanel>
                            <Border Background="{DynamicResource CardInnerBgBrush}" BorderBrush="{DynamicResource BorderGoldBrush}" BorderThickness="1" CornerRadius="3" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="STABLE ENGINE" Foreground="{DynamicResource GoldPrimaryBrush}" FontSize="10" FontWeight="Bold" Margin="0"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
