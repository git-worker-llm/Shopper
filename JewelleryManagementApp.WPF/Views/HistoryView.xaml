<UserControl x:Class="JewelleryManagementApp.WPF.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:JewelleryManagementApp.WPF.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource DarkBgBrush}">
    
    <UserControl.Resources>
        <helpers:MathAddConverter x:Key="MathAddConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderGoldBrush}" Padding="0,0,0,15" Margin="0,0,0,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="AUDITING &amp; ARCHIVAL SYSTEM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}"/>
                    <TextBlock Text="Showroom Billing Archive &amp; Reprints" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="REFRESH LIST" 
                        Command="{Binding RefreshCommand}" 
                        Background="{DynamicResource CardInnerBgBrush}" 
                        Foreground="{DynamicResource TextLightBrush}" 
                        FontWeight="Bold" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Right" 
                        Height="36" 
                        Padding="15,6" 
                        Margin="0"
                        ToolTip="Reload fresh invoice transaction ledger records."/>
            </Grid>
        </Border>

        <!-- Search Bar Panel -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" Padding="15" CornerRadius="8" Margin="0,0,0,20" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Filter Invoices by Patron: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,4" Margin="0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- DataGrid Table -->
        <Border Grid.Row="2" Padding="20" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
            <DataGrid ItemsSource="{Binding Bills}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice ID" Binding="{Binding Id, StringFormat='INV-{0:D5}'}" Width="100" />
                    <DataGridTextColumn Header="Filing Date" Binding="{Binding Date, StringFormat='dd/MM/yyyy hh:mm tt'}" Width="180" />
                    <DataGridTextColumn Header="Patron Name" Binding="{Binding Customer.Name}" Width="*" />
                    <DataGridTextColumn Header="Subtotal Amount" Binding="{Binding TotalAmount, StringFormat='₹{0:N2}'}" Width="150" />
                    <DataGridTextColumn Header="GST Reconciled" Binding="{Binding GSTAmount, StringFormat='₹{0:N2}'}" Width="130" />
                    <DataGridTemplateColumn Header="Net Amount" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource MathAddConverter}}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Action" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Print Copy" 
                                        Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource CentredActionButton}"
                                        Background="{DynamicResource GoldPrimaryBrush}" 
                                        Foreground="#121212" 
                                        FontWeight="SemiBold"
                                        ToolTip="Re-print standard receipt voucher copy for this sales invoice."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
