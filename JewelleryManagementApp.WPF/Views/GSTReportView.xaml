<UserControl x:Class="JewelleryManagementApp.WPF.Views.GSTReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource DarkBgBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <!-- Main Layout Split -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header and Period Selector -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderGoldBrush}" Padding="0,0,0,15" Margin="0,0,0,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="GST COMPLIANCE CONTROL CENTER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}"/>
                    <TextBlock Text="E-Filing Portal &amp; GSTR-1 Reconciliation Hub" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Filing Period: " FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding AvailablePeriods}" SelectedItem="{Binding SelectedPeriod}" Width="180" Height="36" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI Metrics Grid -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            
            <!-- Metric 1: Gross Sales -->
            <Border Background="{DynamicResource CardBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="GROSS TURNOVER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0"/>
                    <TextBlock Text="{Binding TotalSales, StringFormat='₹{0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,2"/>
                    <TextBlock Text="Taxable + GST Amount" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0"/>
                </StackPanel>
            </Border>

            <!-- Metric 2: Taxable Amount -->
            <Border Background="{DynamicResource CardBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TAXABLE VALUE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0"/>
                    <TextBlock Text="{Binding TaxableAmount, StringFormat='₹{0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource GoldLightBrush}" Margin="0,8,0,2"/>
                    <TextBlock Text="Gold Value (Net of taxes)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0"/>
                </StackPanel>
            </Border>

            <!-- Metric 3: CGST & SGST Splits -->
            <Border Background="{DynamicResource CardBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="CGST / SGST SPLIT (1.5% EACH)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0"/>
                    <TextBlock Text="{Binding CGST, StringFormat='₹{0:N2} / ₹{0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,11,0,2"/>
                    <TextBlock Text="Central &amp; State components" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0"/>
                </StackPanel>
            </Border>

            <!-- Metric 4: Total GST Collected -->
            <Border Background="{DynamicResource CardBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderGoldBrush}" CornerRadius="8" Padding="15" Margin="0">
                <StackPanel>
                    <TextBlock Text="TOTAL GST COLLECTED (3%)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}" Margin="0"/>
                    <TextBlock Text="{Binding TotalGST, StringFormat='₹{0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}" Margin="0,8,0,2"/>
                    <TextBlock Text="Reconciled for filing" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0"/>
                </StackPanel>
            </Border>
            
        </UniformGrid>

        <!-- Filing Actions and History -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Action panel -->
            <Border Grid.Column="0" Margin="0,0,20,0" Padding="20" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                <StackPanel>
                    <TextBlock Text="compliance tasks" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="E-File GST Returns" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Submit current month returns directly to the GST Common Portal with automated HSN summaries and Digital Signature (DSC) validation." 
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20" LineHeight="18"/>

                    <Button Content="FILE GSTR-1 NOW" 
                            Command="{Binding FileGSTCommand}" 
                            Height="44" 
                            Background="{DynamicResource GoldPrimaryBrush}" 
                            Foreground="#121212" 
                            FontWeight="Bold" 
                            FontSize="13" 
                            Margin="0,0,0,10"
                            ToolTip="Verify sales ledger, sign returns using DSC, and submit returns to secure GST common portal."/>

                    <Button Content="EXPORT GSTR-1 (OFFLINE)" 
                            Command="{Binding ExportGSTR1Command}" 
                            Height="40" 
                            Background="{DynamicResource CardInnerBgBrush}" 
                            Foreground="{DynamicResource TextLightBrush}" 
                            FontWeight="Bold" 
                            FontSize="12" 
                            Margin="0"
                            ToolTip="Download offline utility GSTR-1 schema package as JSON or CSV."/>

                    <Border Margin="0,20,0,0" Background="{DynamicResource CardInnerBgBrush}" BorderThickness="1" BorderBrush="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="12">
                        <StackPanel>
                            <TextBlock Text="● DIRECT E-FILING READY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="GSTR-1 JSON schema matches GST offline utility v3.1.4 specifications." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Filing History list -->
            <Border Grid.Column="1" Padding="20" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="GST Return Filing History" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}" Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilingHistory}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Filing Date" Binding="{Binding FilingDate, StringFormat='dd/MM/yyyy hh:mm tt'}" Width="160" />
                            <DataGridTextColumn Header="Filing Period" Binding="{Binding Period}" Width="130" />
                            <DataGridTextColumn Header="Taxable Sales" Binding="{Binding TaxableAmount, StringFormat='₹{0:N2}'}" Width="150" />
                            <DataGridTextColumn Header="GST Filed" Binding="{Binding GstAmount, StringFormat='₹{0:N2}'}" Width="120" />
                            <DataGridTextColumn Header="Acknowledgement Reference (ARN)" Binding="{Binding ReferenceNumber}" Width="*" />
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="Bold" Margin="0"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Filing Progress Loading Overlay -->
        <Border Grid.RowSpan="3" 
                Background="#B3121212" 
                CornerRadius="8" 
                Visibility="{Binding IsFiling, Converter={StaticResource BoolToVis}}" 
                Margin="-20"
                Panel.ZIndex="999">
            <Border Background="{DynamicResource CardBgBrush}" 
                    BorderBrush="{DynamicResource GoldPrimaryBrush}" 
                    BorderThickness="1" 
                    Width="450" 
                    Height="240" 
                    CornerRadius="8" 
                    Padding="30"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SECURE GST filing gateway" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="TRANSMITTING GST DATA..." FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Center" Margin="0,10,0,15"/>
                    
                    <!-- Progress Bar -->
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding FilingProgress}" Background="{DynamicResource CardInnerBgBrush}" Foreground="{DynamicResource GoldPrimaryBrush}" Margin="0,0,0,15">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                    
                    <!-- Action status text -->
                    <TextBlock Text="{Binding FilingStatus}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Height="20" FontStyle="Italic"/>
                    
                    <TextBlock Text="Do not close the application or disconnect from portal" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
