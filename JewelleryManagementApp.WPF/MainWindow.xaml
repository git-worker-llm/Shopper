<Window x:Class="JewelleryManagementApp.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JewelleryManagementApp.WPF"
        xmlns:views="clr-namespace:JewelleryManagementApp.WPF.Views"
        mc:Ignorable="d"
        Title="Jewellery Shop Management" Height="450" Width="800">
    <TabControl SelectionChanged="TabControl_SelectionChanged">
        <TabItem Header="Billing" x:Name="BillingTab">
            <views:BillingView />
        </TabItem>
        <TabItem Header="Inventory">
            <views:InventoryView />
        </TabItem>
        <TabItem Header="Customers">
            <views:CustomerView />
        </TabItem>
        <TabItem Header="History">
            <views:HistoryView />
        </TabItem>
        <TabItem Header="GST Report">
            <views:GSTReportView />
        </TabItem>
        <TabItem Header="Print Setup">
            <views:PrintTemplateView />
        </TabItem>
        <TabItem Header="Dashboard">
            <views:DashboardView />
        </TabItem>
        <TabItem Header="Settings">
            <views:SettingsView />
        </TabItem>
    </TabControl>
</Window>
