<Window x:Class="JewelleryManagementApp.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JewelleryManagementApp.WPF"
        xmlns:views="clr-namespace:JewelleryManagementApp.WPF.Views"
        mc:Ignorable="d"
        Title="AuraJewels - Luxury Suite" 
        Height="700" 
        Width="1100"
        Background="{DynamicResource DarkBgBrush}"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Brand Luxury Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="25,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 10,35 L 20,10 L 35,22 L 50,10 L 65,22 L 80,10 L 90,35 Z M 50,2 A 2,2 0 1 0 50,0 Z" 
                          Fill="{DynamicResource GoldPrimaryBrush}" Height="22" Width="38" Stretch="Fill" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="A U R A J E W E L S" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BorderGoldBrush}" CornerRadius="3" Padding="6,2" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PREMIER ERP" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource GoldLightBrush}" Margin="0"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Welcome, Administrator" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Border Background="{DynamicResource CardInnerBgBrush}" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Right" ToolTip="Authenticated Administrator Session Details">
                        <TextBlock Text="A" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GoldPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Navigation TabControl -->
        <TabControl Grid.Row="1" SelectionChanged="TabControl_SelectionChanged" BorderThickness="0" Margin="0">
            
            <TabItem Header="Billing" x:Name="BillingTab">
                <views:BillingView />
            </TabItem>
            
            <TabItem Header="Inventory">
                <views:InventoryView />
            </TabItem>
            
            <TabItem Header="Customers">
                <views:CustomerView />
            </TabItem>
            
            <TabItem Header="GST Return Center">
                <views:GSTReportView />
            </TabItem>
            
            <TabItem Header="Filing History">
                <views:HistoryView />
            </TabItem>
            
            <TabItem Header="Print Templates">
                <views:PrintTemplateView />
            </TabItem>
            
            <TabItem Header="Business Analytics">
                <views:DashboardView />
            </TabItem>
            
            <TabItem Header="System Settings">
                <views:SettingsView />
            </TabItem>
            
        </TabControl>
    </Grid>
</Window>
